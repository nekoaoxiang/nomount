name: Build BBR LKM Module

on:
  workflow_dispatch:
    inputs:
      ddk_release:
        description: 'DDK release version'
        required: false
        default: '20260313'
        type: string

jobs:
  build-bbr:
    name: Build tcp_bbr.ko for ${{ matrix.kmi }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        kmi:
          - android14-6.1
    container:
      image: ghcr.io/ylarod/ddk-min:${{ matrix.kmi }}-${{ github.event.inputs.ddk_release || '20260313' }}
      options: --privileged

    steps:
    - name: Build tcp_bbr.ko
      run: |
        echo "=== Building tcp_bbr.ko for KMI: ${{ matrix.kmi }} ==="

        # 1. 创建临时编译目录
        WORKDIR=/tmp/bbr_build
        mkdir -p $WORKDIR
        cd $WORKDIR

        # 2. 从容器自带的源码树中复制 tcp_bbr.c
        SRC_BBR=/opt/ddk/src/${{ matrix.kmi }}/net/ipv4/tcp_bbr.c
        if [ ! -f "$SRC_BBR" ]; then
            echo "ERROR: $SRC_BBR not found!"
            exit 1
        fi
        cp $SRC_BBR .

        # 3. 动态生成外置模块 Makefile
        cat << 'EOF' > Makefile
        obj-m += tcp_bbr.o
        EOF

        # 4. 调用 ddk-min 内置的 KDIR 进行模块编译
        KDIR=/opt/ddk/kdir/${{ matrix.kmi }}
        make -C $KDIR M=$WORKDIR modules

        # 5. 输出并剥离调试符号
        OUT_DIR=/github/workspace/out
        mkdir -p $OUT_DIR
        OUTPUT_NAME="${{ matrix.kmi }}_tcp_bbr.ko"

        cp tcp_bbr.ko "$OUT_DIR/$OUTPUT_NAME"
        
        echo "=== Build output ==="
        ls -la "$OUT_DIR/$OUTPUT_NAME"
        echo "Size before strip: $(du -h "$OUT_DIR/$OUTPUT_NAME" | cut -f1)"
        llvm-strip -d "$OUT_DIR/$OUTPUT_NAME"
        echo "Size after strip: $(du -h "$OUT_DIR/$OUTPUT_NAME" | cut -f1)"

    - name: Upload tcp_bbr.ko artifact
      uses: actions/upload-artifact@v7
      with:
        name: tcp_bbr-${{ matrix.kmi }}
        path: /github/workspace/out/${{ matrix.kmi }}_tcp_bbr.ko
